{
  "manifest_version": 3,
  "name": "Relay Ops",
  "version": "0.1.0",
  "description": "Independent browser-operated group research and posting workspace.",
  "action": { "default_title": "Open Relay Ops", "default_popup": "index.html" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "https://web.telegram.org/*"]
}