DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/telegram_auto_bot

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
